# =============================================================================
# FIN-Painel — variáveis de ambiente (todas opcionais; valores padrão abaixo)
# Copie para .env.local em desenvolvimento ou configure no provedor de deploy.
# =============================================================================

# URL pública do site (usada em sitemap.xml, robots.txt e metadados).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Tamanho máximo por arquivo nas ferramentas de servidor, em MB (1–2048).
# Cada processamento usa em memória cerca de 4× o tamanho do arquivo (medido:
# ~3,7 GB para um envio de 900 MB). Com 950 MB e MAX_CONCURRENT_JOBS=2,
# reserve ~8 GB de RAM; em servidores menores, reduza este valor.
MAX_UPLOAD_MB=950

# Tempo máximo de cada processamento no servidor, em segundos (5–3600).
JOB_TIMEOUT_SECONDS=600

# Processamentos simultâneos por instância (1–64). Excedentes aguardam em fila
# (até 4× este valor); acima disso, a API responde 503.
MAX_CONCURRENT_JOBS=2

# Requisições de processamento por minuto (0 desativa). Por IP quando
# TRUST_PROXY=true; caso contrário, é um limite global da instância.
RATE_LIMIT_PER_MINUTE=20

# Defina "true" SOMENTE atrás de um proxy reverso confiável (Nginx, Caddy,
# load balancer) que sobrescreva X-Forwarded-For.
TRUST_PROXY=false

# Caminhos dos binários (se não estiverem no PATH).
GHOSTSCRIPT_PATH=gs
LIBREOFFICE_PATH=soffice
